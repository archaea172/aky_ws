<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <include path="common/bt_node_models.xml"/>

  <BehaviorTree ID="MainTree">
    <Sequence>
      <lifecycle_action node_name="follower_node"
                        state="inactive"/>
      <Delay delay_msec="2000">
        <lifecycle_action node_name="follower_node"
                          state="active"/>
      </Delay>
      <leader_pos_action start_x="0.0"
                         start_y="0.0"
                         goal_x="5.0"
                         goal_y="5.0"
                         max_speed="0.7"/>
      <lifecycle_action node_name="follower_node"
                        state="inactive"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="leader_pos_action"
            editable="true">
      <input_port name="start_x"/>
      <input_port name="start_y"/>
      <input_port name="goal_x"/>
      <input_port name="goal_y"/>
      <input_port name="max_speed"/>
    </Action>
    <Action ID="lifecycle_action"
            editable="true">
      <input_port name="node_name"/>
      <input_port name="state"/>
    </Action>
  </TreeNodesModel>

</root>
