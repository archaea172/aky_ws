<robot name="robot">
  <link name="base_root"/>
  
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="body_joint" type="fixed">
    <parent link="base_root"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>
</robot>
