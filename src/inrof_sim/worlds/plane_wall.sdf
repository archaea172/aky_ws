<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="plane_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    </plane>
                </geometry>
                </collision>
                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
                </visual>
            </link>
        </model>

        <model name="sandbox_walls">
            <static>true</static>

            <!-- north wall with centered opening -->
            <link name="north_wall_left">
                <pose>0.0 5.5 0.175 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>3.0 0.15 0.35</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.0 0.15 0.35</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.45 0.36 0.25 1</ambient>
                        <diffuse>0.45 0.36 0.25 1</diffuse>
                    </material>
                </visual>
            </link>

            <link name="north_wall_right">
                <pose>4.0 5.5 0.175 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>3.0 0.15 0.35</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>3.0 0.15 0.35</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.45 0.36 0.25 1</ambient>
                        <diffuse>0.45 0.36 0.25 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- south wall -->
            <link name="south_wall_left">
                <pose>2.0 -1.5 0.175 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>7.0 0.15 0.35</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>7.0 0.15 0.35</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.45 0.36 0.25 1</ambient>
                        <diffuse>0.45 0.36 0.25 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- west wall -->
            <link name="west_wall">
                <pose>-1.5 2.0 0.175 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.15 7.0 0.35</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.15 7.0 0.35</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.45 0.36 0.25 1</ambient>
                        <diffuse>0.45 0.36 0.25 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- east wall -->
            <link name="east_wall">
                <pose>5.5 2.0 0.175 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.15 7.0 0.35</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.15 7.0 0.35</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.45 0.36 0.25 1</ambient>
                        <diffuse>0.45 0.36 0.25 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>
    </world>
</sdf>
